<?php

/**
 * @file
 * Branch Opening Hours logic.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\file\FileInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_theme().
 */
function eonext_branch_opening_hours_theme($existing, $type, $theme, $path) {
  return [
    'html__node__opening_hours_bare' => [
      'base hook' => 'html',
    ],
    'page__node__opening_hours_bare' => [
      'base hook' => 'page',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK().
 *
 * Provide a bare html theme suggestion.
 */
function eonext_branch_opening_hours_theme_suggestions_html(array $variables): array {
  $suggestions = [];
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ('eonext_branch_opening_hours.node_bare' === $route_name) {
    $suggestions[] = 'html__node__opening_hours_bare';
  }

  return $suggestions;
}

/**
 * Implements hook_theme_suggestions_HOOK().
 *
 * Provide a bare page theme suggestion.
 */
function eonext_branch_opening_hours_theme_suggestions_page(array $variables): array {
  $suggestions = [];
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ('eonext_branch_opening_hours.node_bare' === $route_name) {
    $suggestions[] = 'page__node__opening_hours_bare';
  }

  return $suggestions;
}

/**
 * Implements hook_preprocess_HOOK() for html__node__opening_hours_bare.
 */
function eonext_branch_opening_hours_preprocess_html__node__opening_hours_bare(array &$variables): void {
  $branch_node = \Drupal::routeMatch()->getParameter('node');
  if (!$branch_node instanceof NodeInterface) {
    return;
  }

  $variables['attributes']['class'][] = 'opening-hours--bare';
  $variables['head_title'] = t(
    '@library_name | Opening Hours',
    ['@library_name' => $branch_node->getTitle()],
    ['context' => 'eonext']
  );
}

/**
 * Implements hook_preprocess_HOOK() for page__node__opening_hours_bare.
 */
function eonext_branch_opening_hours_preprocess_page__node__opening_hours_bare(array &$variables): void {
  $logo_url = _eonext_branch_opening_hours_get_logo_url();
  $variables['opening_hours_bare_logo_url'] = $logo_url;

  $variables['#attached']['library'][] = 'eonext_branch_opening_hours/bare_layout';

  $variables['#cache']['tags'][] = 'config:eonext_branch_opening_hours.settings';
  $fid = \Drupal::config('eonext_branch_opening_hours.settings')->get('logo');
  if (!empty($fid)) {
    $variables['#cache']['tags'][] = 'file:' . $fid;
  }
}

/**
 * Checks whether a managed file's URI resolves to an existing file.
 *
 * @param \Drupal\file\FileInterface $file
 *   The file entity.
 *
 * @return bool
 *   TRUE when the stream wrapper reports a readable path on disk.
 */
function _eonext_branch_opening_hours_file_uri_exists(FileInterface $file): bool {
  $uri = $file->getFileUri();
  if ($uri === '' || $uri === NULL) {
    return FALSE;
  }
  $wrapper = \Drupal::service('stream_wrapper_manager')->getViaUri($uri);
  if ($wrapper === FALSE) {
    return FALSE;
  }
  $path = $wrapper->realpath();
  return $path !== FALSE && is_file($path);
}

/**
 * Returns the absolute public URL for the configured logo, if any.
 *
 * @return string|null
 *   Absolute URL, or NULL when no usable logo is configured.
 */
function _eonext_branch_opening_hours_get_logo_url(): ?string {
  $fid = \Drupal::config('eonext_branch_opening_hours.settings')->get('logo');
  if (empty($fid)) {
    return NULL;
  }
  $file = \Drupal::entityTypeManager()->getStorage('file')->load($fid);
  if (!$file instanceof FileInterface || !_eonext_branch_opening_hours_file_uri_exists($file)) {
    return NULL;
  }
  return \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
}

/**
 * Implements hook_entity_insert().
 *
 * Triggers on creation of a 'branch' node.
 */
function eonext_branch_opening_hours_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'branch') {
    _eonext_branch_opening_hours_trigger($entity, 'insert');
  }
}

/**
 * Implements hook_entity_update().
 *
 * Triggers on update of a 'branch' node.
 */
function eonext_branch_opening_hours_entity_update(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'branch') {
    _eonext_branch_opening_hours_trigger($entity, 'update');
  }
}

/**
 * Sends branch node data to an external API.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The branch node being processed.
 * @param string $action
 *   The type of action performed: 'insert' or 'update'.
 */
function _eonext_branch_opening_hours_trigger(NodeInterface $node, string $action): void {
  $config = \Drupal::config('eonext_branch_opening_hours.settings');

  if (!$config->get('enabled')) {
    return;
  }

  $domain = trim($config->get('domain'), '/');
  $consumer_hash = $config->get('consumer_hash');

  // Construct the URL for the POST request.
  $url = "https://{$domain}/{$consumer_hash}/update-google-business/opening-hours";

  // Build the request payload.
  $payload = [
    'libraryId' => $node->id(),
    'libraryTitle' => $node->label(),
    'action' => $action,
  ];

  \Drupal::logger('eonext_branch_opening_hours')->debug(
    'branch ID @id; Title: @title; action: @action',
    [
      '@id' => $node->id(),
      '@title' => $node->label(),
      '@action' => $action,
    ]
  );

  try {
    $client = \Drupal::httpClient();
    $client->post($url, [
      'headers' => ['Content-Type' => 'application/json'],
      'json' => $payload,
    ]);
  }
  catch (\Exception $e) {
    \Drupal::logger('eonext_branch_opening_hours')->error(
      'Failed to push opening hours for branch ID @id: @message',
      [
        '@id' => $node->id(),
        '@message' => $e->getMessage(),
      ]
    );
  }
}
